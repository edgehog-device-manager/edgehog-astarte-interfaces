{
  "interface_name": "io.edgehog.devicemanager.apps.ImageEvent",
  "version_major": 0,
  "version_minor": 1,
  "type": "datastream",
  "ownership": "device",
  "aggregation": "object",
  "description": "Container image events sampled data.",
  "doc": "Allows to stream container image events data, including status, message and additional info.",
  "mappings": [
    {
      "endpoint": "/%{image_id}/status",
      "type": "string",
      "database_retention_policy": "use_ttl",
      "database_retention_ttl": 31556952,
      "explicit_timestamp": true,
      "description": "Image status",
      "doc": "Possible values: [Create, Delete, Import, Load, Pull, Push, Save, Tag, Untag, Prune, Error]"
    },
    {
      "endpoint": "/%{image_id}/message",
      "type": "string",
      "database_retention_policy": "use_ttl",
      "database_retention_ttl": 31556952,
      "explicit_timestamp": true,
      "description": "Optional message for the event"
    },
    {
      "endpoint": "/%{image_id}/addInfo",
      "type": "stringarray",
      "database_retention_policy": "use_ttl",
      "database_retention_ttl": 31556952,
      "explicit_timestamp": true,
      "description": "Additional info",
      "doc": "Additional info about the event."
    }
  ]
}
