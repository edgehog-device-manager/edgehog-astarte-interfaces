{
  "interface_name": "io.edgehog.devicemanager.apps.SystemPruneResponse",
  "version_major": 0,
  "version_minor": 1,
  "type": "datastream",
  "ownership": "device",
  "aggregation": "object",
  "description": "Response for a system prune request.",
  "doc": "Reports the status, message, reclaimed disk space, and additional info for a SystemPruneRequest.",
  "mappings": [
    {
      "endpoint": "/response/requestId",
      "type": "string",
      "database_retention_policy": "use_ttl",
      "database_retention_ttl": 31556952,
      "explicit_timestamp": true,
      "description": "System prune request ID",
      "doc": "ID matching the corresponding SystemPruneRequest."
    },
    {
      "endpoint": "/response/status",
      "type": "string",
      "database_retention_policy": "use_ttl",
      "database_retention_ttl": 31556952,
      "explicit_timestamp": true,
      "description": "System prune status",
      "doc": "Possible values: [Success, Error]"
    },
    {
      "endpoint": "/response/message",
      "type": "string",
      "database_retention_policy": "use_ttl",
      "database_retention_ttl": 31556952,
      "explicit_timestamp": true,
      "description": "Optional message for the response"
    },
    {
      "endpoint": "/response/addInfo",
      "type": "stringarray",
      "database_retention_policy": "use_ttl",
      "database_retention_ttl": 31556952,
      "explicit_timestamp": true,
      "description": "Additional info",
      "doc": "Additional info about the prune response."
    },
    {
      "endpoint": "/response/imageReclaimed",
      "type": "longinteger",
      "database_retention_policy": "use_ttl",
      "database_retention_ttl": 31556952,
      "explicit_timestamp": true,
      "description": "Disk space reclaimed from pruning images in bytes",
      "doc": "Amount of disk space reclaimed in bytes after pruning unused images."
    },
    {
      "endpoint": "/response/containerReclaimed",
      "type": "longinteger",
      "database_retention_policy": "use_ttl",
      "database_retention_ttl": 31556952,
      "explicit_timestamp": true,
      "description": "Disk space reclaimed from pruning containers in bytes",
      "doc": "Amount of disk space reclaimed in bytes after pruning stopped containers."
    }
  ]
}
